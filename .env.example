# Tasseer operational database (read-only support user recommended, NOT the app's write user)
TASSEER_DB_HOST=localhost
TASSEER_DB_PORT=3306
TASSEER_DB_NAME=ksatntau_api
TASSEER_DB_USER=tasseer_support_ro
TASSEER_DB_PASSWORD=

# Google Gemini (free tier) for language understanding + response generation
# Get a free key at https://aistudio.google.com/apikey - no billing required for the free tier.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# This service does not own customer auth. The in-app chat screen sends the SAME bearer
# token the app already uses against the main API; this service verifies it by calling
# GET /api/user on the main API rather than duplicating auth logic.
TASSEER_API_BASE_URL=https://api.ksatasseerltdapi.com

# WhatsApp Cloud API (human handoff) - https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_SUPPORT_PHONE_E164=+9665XXXXXXXX

# App
SUPPORT_ENV=development
SUPPORT_LOG_LEVEL=INFO
