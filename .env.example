# Tasseer operational database (read-only support user recommended, NOT the app's write user)
# Host/port as seen from wherever the DB is actually dialed from: if SSH_TUNNEL_HOST is set
# below, that's the SSH server's own perspective (i.e. "localhost", same box as the DB) -
# NOT this app's perspective. Leave as localhost:3306 in that case.
TASSEER_DB_HOST=localhost
TASSEER_DB_PORT=3306
TASSEER_DB_NAME=ksatntau_api
TASSEER_DB_USER=tasseer_support_ro
TASSEER_DB_PASSWORD=

# SSH tunnel - only needed when this service runs somewhere that can't reach the DB
# directly (e.g. Render). Namecheap shared hosting doesn't expose MySQL remotely at
# all except via SSH port-forwarding (confirmed by Namecheap support) - leave
# SSH_TUNNEL_HOST blank to skip the tunnel entirely (e.g. deployed on the same
# server as the DB, where TASSEER_DB_HOST=localhost already works directly).
# Use a SEPARATE, dedicated SSH key for this - not your personal one - so it can be
# revoked independently. SSH_TUNNEL_PRIVATE_KEY is the raw PEM content, not a file path.
SSH_TUNNEL_HOST=
SSH_TUNNEL_PORT=21098
SSH_TUNNEL_USERNAME=
SSH_TUNNEL_PRIVATE_KEY=
SSH_TUNNEL_PRIVATE_KEY_PASSPHRASE=

# Google Gemini (free tier) for language understanding + response generation
# Get a free key at https://aistudio.google.com/apikey - no billing required for the free tier.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# This service does not own customer auth. The in-app chat screen sends the SAME bearer
# token the app already uses against the main API; this service verifies it by calling
# GET /api/user on the main API rather than duplicating auth logic.
TASSEER_API_BASE_URL=https://api.ksatasseerltdapi.com

# WhatsApp Cloud API (human handoff) - https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_SUPPORT_PHONE_E164=+9665XXXXXXXX

# App
SUPPORT_ENV=development
SUPPORT_LOG_LEVEL=INFO
